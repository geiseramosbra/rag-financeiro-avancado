# 📊 Configuração de Variáveis de Ambiente
# Para executar este projeto localmente, crie um arquivo chamado '.env'
# e preencha com as suas chaves reais.

GROQ_API_KEY=insira_seu_token_groq_aqui
COHERE_API_KEY=insira_seu_token_cohere_aqui
QDRANT_URL=insira_a_url_do_seu_cluster_aqui
QDRANT_API_KEY=insira_sua_chave_qdrant_aqui